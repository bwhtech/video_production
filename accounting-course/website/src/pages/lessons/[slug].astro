---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { lessons, modules, courseName, lessonHref, type Lesson } from '../../data/course';
import '../../styles/player.css';
export function getStaticPaths() {
  return lessons.map(lesson => ({ params: { slug: lesson.slug }, props: { lesson } }));
}
interface Props { lesson: Lesson; }
const { lesson } = Astro.props;
const previous = lessons[lesson.number - 2];
const next = lessons[lesson.number];
const module = modules[lesson.module];
---
<Layout title={`${lesson.title} — ${courseName}`} description={lesson.description}>
  <main id="main" class="player-page wrap">
    <a class="text-link back-link" href={`/#${module.id}`}><span aria-hidden="true">←</span> All lessons</a>
    <div class="player-heading"><p>Chapter {lesson.module + 1} · {module.title}</p><h1>{lesson.title}</h1><span>Lesson {lesson.number} of {lessons.length}</span></div>
    <div class="player-layout"><div class="player-main">
      <section class="player-placeholder" aria-labelledby="placeholder-title"><span class="placeholder-note">Your seat at the stall</span><img src="/art/khata.webp" alt="Khata is ready with his ledger open." width="920" height="480" /><h2 id="placeholder-title">This lesson is brewing.</h2><p>The video player will live right here.<br />For now, take a look at what’s on the menu.</p><span class="placeholder-label">Player preview · Video coming soon</span></section>
      <section class="lesson-about"><h2>In this lesson</h2><p>{lesson.description}</p><div class="takeaway"><Icon name="spark" size={22} /><p>{lesson.takeaway}</p></div>{lesson.checkpoint && <p class="checkpoint-note">Your turn: this lesson includes a challenge with Aman’s samosa cart.</p>}</section>
      <nav class="lesson-navigation" aria-label="Previous and next lesson">{previous ? <a class="text-link" href={lessonHref(previous)}>← Previous lesson</a> : <a class="text-link" href="/#lessons">← Course menu</a>}{next ? <a class="button" href={lessonHref(next)}>Next lesson <Icon name="arrow" size={18} /></a> : <a class="button" href="/#lessons">Back to lessons <Icon name="check" size={18} /></a>}</nav>
    </div><aside class="player-sidebar" aria-label="Course lessons"><h2>The course menu</h2>{modules.map((group, index) => <div class="sidebar-module"><h3>{group.title}</h3><ol>{lessons.filter(item => item.module === index).map(item => <li><a href={lessonHref(item)} aria-current={item.slug === lesson.slug ? 'page' : undefined}><span>{String(item.number).padStart(2, '0')}</span><span>{item.title}</span>{item.slug === lesson.slug && <Icon name="play" size={14} />}</a></li>)}</ol></div>)}</aside></div>
  </main>
</Layout>
