<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <title>Accounting, Finally — Lesson 8 · The Journal</title>
    <!-- GENERATED from index.tpl.html by build.py — edit the template, not this file. -->
    <link rel="stylesheet" href="assets/kit/fonts.css" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <script src="assets/kit/icons.js"></script>
    <script src="assets/kit/kit.js"></script>
    <script src="assets/kit/rig.js"></script>
    <script src="assets/kit/cast.js"></script>
    <script src="assets/kit/devices.js"></script>
    <script src="assets/kit/books.js"></script>
    <script src="assets/kit/props2.js"></script>
    <script src="assets/timeline.js"></script>
    <script src="assets/scenes/_shared.js"></script>
{{SCENE_SCRIPTS}}
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #b7895a; }
      #root { position: relative; width: 1920px; height: 1080px; overflow: hidden; }
      .layer { position: absolute; inset: 0; width: 1920px; height: 1080px; }
      #bg { background: #b7895a; }
      svg { display: block; }
      .fontwarm { position: absolute; left: -9999px; font-family: "Baloo 2", Kalam; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="{{TOTAL}}" data-width="1920" data-height="1080">
      <div id="bg" class="layer"></div>
      <!-- shared paper materials: one defs block for every scene svg -->
      <svg width="0" height="0" style="position:absolute">
        <defs>
          <pattern id="pat-cover" patternUnits="userSpaceOnUse" width="768" height="432"><image href="assets/kit/tex/cover.jpg" width="768" height="432" /></pattern>
          <pattern id="pat-paper" patternUnits="userSpaceOnUse" width="768" height="432"><image href="assets/kit/tex/paper.jpg" width="768" height="432" /></pattern>
          <pattern id="pat-kraft" patternUnits="userSpaceOnUse" width="768" height="432"><image href="assets/kit/tex/kraft.jpg" width="768" height="432" /></pattern>
          <pattern id="pat-grain" patternUnits="userSpaceOnUse" width="768" height="432"><image href="assets/kit/tex/construction.jpg" width="768" height="432" /></pattern>
          <filter id="sh1" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="3" dy="4" stdDeviation="2" flood-color="#3b2614" flood-opacity="0.35" /></filter>
          <filter id="sh2" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="6" dy="8" stdDeviation="3.5" flood-color="#3b2614" flood-opacity="0.38" /></filter>
          <!-- STATIC hand-cut edge for paper icons (never animated — no boil) -->
          <filter id="rough" x="-15%" y="-15%" width="130%" height="130%"><feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="3" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" xChannelSelector="R" yChannelSelector="G" /></filter>
          <filter id="sh3" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="10" dy="14" stdDeviation="6" flood-color="#3b2614" flood-opacity="0.4" /></filter>
        </defs>
      </svg>
      <div class="fontwarm"><span style="font-family:'Baloo 2';font-weight:800">₹1,06,700</span><span style="font-family:Kalam">Credit the giver ₹</span></div>
{{SECTIONS}}
      <!-- global seam layer: torn-paper wipes live above every scene -->
      <section id="seams" class="clip" data-start="0" data-duration="{{TOTAL}}" data-track-index="5"><svg id="seams-svg" class="layer" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg"></svg></section>
{{AUDIO}}
    </div>
    <script>
      // Build every scene synchronously onto ONE paused master timeline (absolute times from TL).
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      const order = Object.keys(TL.scenes);
      for (const id of order) {
        const build = window.SCENES && window.SCENES[id];
        const svg = document.getElementById(id + "-svg");
        const sc = TL.scenes[id];
        if (build) build({ svg, tl, K: window.KIT, sc, next: TL.scenes[order[order.indexOf(id) + 1]] });
        else window.PLACEHOLDER(svg, id, sc.title);
      }
      window.SEAMS && window.SEAMS(tl);
      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
